           <item>
            <widget class="QLabel" name="label_2">
             <property name="styleSheet">
              <string notr="true">background-color: rgb(255, 255, 255);</string>
             </property>
             <property name="text">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Score Sleep Stages YASA&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QLabel" name="label_5">
             <property name="styleSheet">
              <string notr="true">background-color: rgb(255, 255, 255);</string>
             </property>
             <property name="text">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;This tool detects &lt;span style=&quot; font-weight:600;&quot;&gt;sleep stages&lt;/span&gt; from PSG files.&lt;/p&gt;&lt;p&gt;Detection is performed on the entire recording with 30 second epochs corresponding to each sleep stage.&lt;br/&gt;The tool can detect sleep stages based on only one EEG electrode, prefered centreal ones (C3, C4).&lt;/p&gt;&lt;p&gt;To enhance the perforamance of the algorithm, you can use one EOG and one EMG channel that can increase&lt;br/&gt;classification accuracy.&lt;br/&gt;You can also select 4 high-priority EEG channels as input, allowing the tool to determine the result with &lt;br/&gt;the highest confidence for each channel.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </widget>
       </item>
       <item>
